5" value="«include»" style="text;html=1;strokeColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;fontSize=12;fontStyle=0;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="594" y="776" width="66" height="17" as="geometry"/></mxCell><mxCell id="uc36" value="Пошук без критеріїв повертає всі конференції.&lt;br&gt;Пошук без відкритого файлу показує підказку&lt;br&gt;«Файл не відкрито».&lt;br&gt;Зберегти й трансформувати можна поточні&lt;br&gt;результати пошуку, тому ці дії доступні&lt;br&gt;лише після виконання пошуку." style="shape=note;size=12;html=1;whiteSpace=wrap;align=left;spacingLeft=6;fontSize=12;fillColor=#fff9d6;strokeColor=#222222;" vertex="1" parent="1"><mxGeometry x="735" y="392" width="335" height="128" as="geometry"/></mxCell><mxCell id="uc37" value="Значення атрибутів підвантажуються у випадні&lt;br&gt;списки: користувач обирає лише наявні у файлі." style="shape=note;size=12;html=1;whiteSpace=wrap;align=left;spacingLeft=6;fontSize=12;fillColor=#fff9d6;strokeColor=#222222;" vertex="1" parent="1"><mxGeometry x="735" y="680" width="335" height="62" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="cl" name="2 - Class"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2020" pageHeight="1664" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cl10" value="XmlAnalyzerApp  (інтерфейс .NET MAUI)" style="shape=folder;fontStyle=1;spacingTop=2;tabWidth=270;tabHeight=22;tabPosition=left;html=1;verticalAlign=top;align=left;spacingLeft=10;fontSize=13;fillColor=none;strokeColor=#9a8a92;fontColor=#5a4650;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1980" height="488" as="geometry"/></mxCell><mxCell id="cl28" value="XmlAnalyzer  (бібліотека логіки, без залежності від MAUI)" style="shape=folder;fontStyle=1;spacingTop=2;tabWidth=373;tabHeight=22;tabPosition=left;html=1;verticalAlign=top;ali