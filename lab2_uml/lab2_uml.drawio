<mxfile host="app.diagrams.net" type="device"><diagram id="uc" name="1 - Use Case"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="870" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="uc3" value="XML Conference Analyzer: аналіз XML-файлів про наукові конференції" style="rounded=0;html=1;verticalAlign=top;fontSize=15;fontStyle=1;fillColor=#ffffff;strokeColor=#222222;" vertex="1" parent="1"><mxGeometry x="190" y="20" width="900" height="830" as="geometry"/></mxCell><mxCell id="uc4" value="Користувач" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=13;strokeColor=#222222;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="57" y="390" width="36" height="60" as="geometry"/></mxCell><mxCell id="uc5" value="Відкрити XML-файл" style="ellipse;html=1;whiteSpace=wrap;fontSize=13;fillColor=#eaf2fb;strokeColor=#222222;" vertex="1" parent="1"><mxGeometry x="280.0" y="81.0" width="240" height="58" as="geometry"/></mxCell><mxCell id="uc6" value="Відкрити вбудований&lt;br&gt;приклад conferences.xml" style="ellipse;html=1;whiteSpace=wrap;fontSize=13;fillColor=#eaf2fb;strokeColor=#222222;" vertex="1" parent="1"><mxGeometry x="280.0" y="166.0" width="240" height="58" as="geometry"/></mxCell><mxCell id="uc7" value="Знайти конференції" style="ellipse;html=1;whiteSpace=wrap;fontSize=13;fillColor=#eaf2fb;strokeColor=#222222;" vertex="1" parent="1"><mxGeometry x="280.0" y="266.0" width="240" height="58" as="geometry"/></mxCell><mxCell id="uc8" value="Очистити результати&lt;br&gt;і параметри пошуку" style="ellipse;html=1;whiteSpace=wrap;fontSize=13;fillColor=#eaf2fb;strokeColor=#222222;" vertex="1" parent="1"><mxGeometry x="280.0" y="361.0" width="240" height="58" as="geometry"/></mxCell><mxCell id="uc9" value="Зберегти результати&lt;br&gt;у XML-файл" style="ellipse;html=1;whiteSpace=wrap;fontSize=13;fil